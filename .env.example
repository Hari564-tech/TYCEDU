# Public browser configuration. Safe to expose only when Supabase RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret. Add to Vercel Project Settings > Environment Variables.
# NEVER prefix this with VITE_ and never commit the real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only by the one-time curriculum seeding script, never by the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
